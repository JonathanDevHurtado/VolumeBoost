<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup=false: no se extrae nada ni a la nube ni a otro dispositivo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>

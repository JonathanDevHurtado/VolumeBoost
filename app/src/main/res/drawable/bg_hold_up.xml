<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FFE65100" android:endColor="#FFB71C1C" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FFFFB300" android:endColor="#FFFF3D00" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
